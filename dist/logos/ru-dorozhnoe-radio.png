600,1609],{"id":1592,"podcastId":1167,"name":1593,"slug":1594,"likes":930,"visites":949,"myLikesCount":10,"duration":1595,"publishDate":1596,"draft":21,"text":1597,"audioLink":1598,"mainImage":10,"created_at":1599,"updated_at":1599},1627,"История катушечного магнитофона «Маяк»","istoriya-katushechnogo-magnitofona-mayak","00:04:06","2023-10-26 17:07:53","\u003Cp>\u003Cspan class=\"ql-font-monospace\" style=\"color: rgb(0, 0, 0);\">Для многих советских ребят это была техника, с которой началось путешествие в мир стереозвука. Сделайте погромче, расскажу о катушечных магнитофонах «Маяк».\u003C/span>\u003C/p>","https://files.redbasset.tech/redbasset/episode/1/14/16267/1637760337703_1121_19_00________________________________________________.mp3","2023-10-26 16:10:05",{"id":1601,"podcastId":1167,"name":1602,"slug":1603,"likes":37,"visites":1485,"myLikesCount":10,"duration":1604,"publishDate":1605,"draft":21,"text":1606,"audioLink":1607,"mainImage":10,"created_at":1608,"updated_at":1608},1437,"Советская мебель","sovetskaya-mebel","00:03:27","2023-10-24 10:39:00","\u003Cp>\u003Cspan class=\"ql-font-monospace\" style=\"color: rgb(0, 0, 0);\">Она до сих пор часто встречается во многих российских квартирах. Стандартизированная, функциональная и скромная. Сегодняшний рассказ о советской мебели.\u003C/span>\u003C/p>","https://files.redbasset.tech/redbasset/episode/1/14/18613/1648204791557_0326_11_00__________________________________________________.mp3","2023-10-24 17:10:32",{"id":1610,"podcastId":1167,"name":1611,"slug":1612,"likes":34,"visites":967,"myLikesCount":10,"duration":1613,"publishDate":1614,"draft":21,"text":1615,"audioLink":1616,"mainImage":10,"created_at":1617,"updated_at":1617},1864,"Кеды","kedyu","00:03:50","2023-07-26 09:30:00","\u003Cp>\u003Cspan class=\"ql-font-monospace\" style=\"color: rgb(0, 0, 0);\">Сегодня расскажем о кедах: простой спортивной обуви, которая значит нечто большее. Что означает это слово? Где производились советские кеды? Какие виды этой обуви мы знаем сегодня?\u003C/span>\u003C/p>","https://files.redbasset.tech/redbasset/episode/1/14/11331/1627291816769_0725_19_00___________________________.mp3","2023-11-01 16:39:08",{"id":1619,"filename":1620,"disk_path":1621,"dir":1624,"mime_type":346,"name":1627,"created_at":1628,"updated_at":1628},43893,"450х190 (4)-927.3219988834176.jpg",{"horizontal":1622},{"desktop":1623,"mobile":1623},"https://api.dorognoe.ru/images/7JhKvVnbgwxXRHf9sRDfHvdIQ2wmkKUErH81r7k7_horizontal_desktop.webp",{"horizontal":1625},{"desktop":1626,"mobile":1626},"images/7JhKvVnbgwxXRHf9sRDfHvdIQ2wmkKUErH81r7k7_horizontal_desktop.webp","450х190 (4)-927.3219988834176","2024-08-27T11:31:58.000000Z","Когда мы рассказываем о чём-то хорошем, что было с нами в прошлом, мы говорим именно так — В ТО ВРЕМЯ.",{"id":1202,"name":271,"slug":272,"likes":1510,"visites":1588,"weight":34,"episodes":1631,"mainImage":1656,"digest":1666},[1632,1640,1648],{"id":1633,"podcastId":1202,"name":1634,"slug":1635,"likes":34,"visites":34,"myLikesCount":10,"duration":10,"publishDate":1636,"draft":21,"text":1637,"audioLink":1638,"mainImage":10,"created_at":1639,"updated_at":1639},3181,"Путешествие с удовольствием (04.09.2026)","puteshestvie-s-udovolstviem-04-09-2026","2026-09-04 13:22:56","\u003Cp>Какую новинку представил Музей Мирового океана, что нужно для аренды байка или авто на Занзибаре и чем стали для туристов два старых Boeing в Малайзии\u003C/p>","https://files.redbasset.tech/redbasset/episode/1/772/78023/2026-09-04T10:22:49.749160012_0904_14_30_PsU_Lahteev.mp3","2026-09-04 13:23:27",{"id":1641,"podcastId":1202,"name":1642,"slug":1643,"likes":34,"visites":34,"myLikesCount":10,"duration":10,"publishDate":1644,"draft":21,"text":1645,"audioLink":1646,"mainImage":10,"created_at":1647,"updated_at":1647},3179,"Путешествие с удовольствием (03.09.2026)","puteshestvie-s-udovolstviem-03-09-2026","2026-09-03 14:48:00","\u003Cp>Как с лёгкостью познакомиться с чайной культурой Иркутска, какие сувениры теперь модно привозить из